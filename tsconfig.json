{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/routes", "src/hooks.server.js"],
  "compilerOptions": {
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$env/static/public": ["src/shims/env-public.ts"],
      "$env/dynamic/private": ["src/shims/env-private.ts"],
      "$app/environment": ["src/shims/app-environment.ts"],
      "$app/state": ["src/shims/app-state.svelte.ts"]
    }
  }
}
