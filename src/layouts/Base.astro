---
import { ClientRouter } from "astro:transitions";
import { SITE } from "$lib/config";
import { getDynamicThemeCSS } from "$lib/server/theme";
import { getAlmanac } from "$lib/utils/almanac";
import { fetchSiteInfo } from "$lib/services/atproto/fetch";
import { normalizeSiteInfo } from "$lib/services/atproto/siteInfo";
import { PUBLIC_ATPROTO_DID, PUBLIC_LEAFLET_BLOG_PUBLICATION } from "$env/static/public";
import Header from "../components/Header.astro";
import Colophon from "../components/Colophon.astro";
import BacklinkAvatars from "$lib/components/BacklinkAvatars.astro";
import AmbianceEngine from "$lib/components/AmbianceEngine.astro";
import SeasonalThemeUpdater from "$lib/components/SeasonalThemeUpdater.astro";
import WolfPawTrail from "$lib/components/WolfPawTrail.astro";
import MondayEgg from "$lib/components/ostara-eggs/MondayEgg.astro";
import IdleEgg from "$lib/components/ostara-eggs/IdleEgg.astro";
import ThreeToast from "$lib/components/ostara-eggs/ThreeToast.astro";
import BlogArchiveEggs from "$lib/components/ostara-eggs/BlogArchiveEggs.astro";
import "../styles/riso.css";

interface Props {
  title?: string;
  description?: string;
  /** Short subtitle for the generated OG image (≤60 chars ideal). */
  ogSubtitle?: string;
  /** Label on the OG image, e.g. BLOG, ABOUT. */
  ogType?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  author?: string;
  /** rkey of the site.standard.document record for this page. */
  documentRkey?: string;
  /** Extra URLs / AT-URIs whose backlinks to show (the page URL is always included). */
  backlinkTargets?: string[];
}

const { title, description, ogSubtitle, ogType, image, type = "website", publishedTime, tags, author, documentRkey, backlinkTargets = [] } =
  Astro.props;

const almanac = getAlmanac();
const siteInfo = normalizeSiteInfo(await fetchSiteInfo(fetch).catch(() => null));

const pathname = Astro.url.pathname;
const backlinks = [`https://ewancroft.uk${pathname}`, ...backlinkTargets];
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.ogTitle;
const fullDescription = description ?? siteInfo?.additionalInfo?.purpose ?? SITE.description;
const canonical = new URL(pathname, Astro.url.origin).href;

const projectLicense = siteInfo?.openSourceInfo?.license;
const pageLicense = pathname.startsWith("/blog")
  ? (siteInfo?.additionalInfo?.sectionLicense.find((l) => l.section?.toLowerCase() === "blog") ?? projectLicense)
  : projectLicense;

const publicationAtUri =
  (!title || ogType === "BLOG") && PUBLIC_ATPROTO_DID && PUBLIC_LEAFLET_BLOG_PUBLICATION
    ? `at://${PUBLIC_ATPROTO_DID}/site.standard.publication/${PUBLIC_LEAFLET_BLOG_PUBLICATION}`
    : undefined;
const documentAtUri =
  documentRkey && PUBLIC_ATPROTO_DID ? `at://${PUBLIC_ATPROTO_DID}/site.standard.document/${documentRkey}` : undefined;

const rawSubtitle = ogSubtitle ?? description;
const ogSub = rawSubtitle && rawSubtitle.length > 150 ? `${rawSubtitle.slice(0, 147)}…` : rawSubtitle;
const ogImage = (() => {
  if (image) return new URL(image, Astro.url.origin).href;
  const params = new URLSearchParams();
  if (title) params.set("title", title);
  if (ogType) params.set("type", ogType);
  if (ogSub) params.set("subtitle", ogSub);
  params.set("slug", pathname);
  return new URL(`/api/og/generate?${params}`, Astro.url.origin).href;
})();
const ogAlt = `Social preview for ${title ?? SITE.title}${ogType ? `, labelled ${ogType.replaceAll("_", " ").toLowerCase()}` : ""}.`;
---

<!doctype html>
<html lang="en-GB" style="color-scheme: light dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ewan's Corner" href="/rss.xml" />
    <meta name="theme-color" content="#f1f3f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d14" media="(prefers-color-scheme: dark)" />
    {pageLicense?.url && <link rel="license" href={pageLicense.url} title={pageLicense.name} />}

    {publicationAtUri && <link rel="site.standard.publication" href={publicationAtUri} />}
    {documentAtUri && <link rel="site.standard.document" href={documentAtUri} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImage.startsWith("https://") && <meta property="og:image:secure_url" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_GB" />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && author && <meta property="article:author" content={author} />}
    {type === "article" && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ewancroft" />
    <meta name="twitter:creator" content="@ewancroft" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <style id="sabbat-dynamic-theme" set:html={getDynamicThemeCSS()} is:global></style>
    <ClientRouter />
  </head>
  <body>
    <SeasonalThemeUpdater transition:persist="theme" />
    <AmbianceEngine transition:persist="ambiance" />
    <WolfPawTrail transition:persist="paws" />
    <MondayEgg transition:persist="egg-monday" />
    <IdleEgg transition:persist="egg-idle" />
    <ThreeToast transition:persist="egg-toast" />
    <BlogArchiveEggs transition:persist="egg-archive" />

    <!-- Shared SVG filters, kept for .text-outline consumers. -->
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="text-outline" x="-20%" y="-60%" width="140%" height="220%" color-interpolation-filters="sRGB">
        <feMorphology in="SourceGraphic" operator="dilate" radius="1.1" result="thick" />
        <feComposite in="thick" in2="SourceGraphic" operator="out" />
      </filter>
    </svg>

    <a class="skip-to-content" href="#main-content">Skip to content</a>
    <Header almanac={almanac} />
    <div class="shell-main" id="main-content" tabindex="-1">
      <slot />
    </div>
    {Astro.response.status !== 404 && (
      <div class="wrap backlinks"><BacklinkAvatars targets={backlinks} /></div>
    )}
    <Colophon almanac={almanac} siteInfo={siteInfo} />

    <script>
      // Any element with data-copy copies that text and briefly says so.
      import { pulseAmbiance } from "$lib/stores/ambiance";
      document.addEventListener("click", async (event) => {
        const el = (event.target as HTMLElement).closest<HTMLElement>("[data-copy]");
        if (!el) return;
        const label = el.dataset.label ?? el.textContent ?? "";
        el.dataset.label = label;
        try {
          await navigator.clipboard?.writeText(el.dataset.copy ?? "");
          el.textContent = "Copied";
          pulseAmbiance();
        } catch {
          return;
        }
        setTimeout(() => (el.textContent = label), 2000);
      });
    </script>
  </body>
</html>
