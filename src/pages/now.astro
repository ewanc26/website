---
import Base from "../layouts/Base.astro";
import Slab from "../components/Slab.astro";
import NowPlaying from "$lib/components/NowPlaying.astro";
import { fetchRecentPlays } from "$lib/services/atproto/plays";
import { getHomeData } from "$lib/services/home";
import { fetchWatching } from "$lib/services/atproto/watching";
import { fetchRecentPosts } from "$lib/services/atproto/feed";
import { PUBLIC_ATPROTO_DID } from "$env/static/public";
import { getAlmanac } from "$lib/utils/almanac";

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");

const almanac = getAlmanac();
const [{ kibunStatus, musicStatus }, plays, watching, feed] = await Promise.all([
  getHomeData(),
  fetchRecentPlays(PUBLIC_ATPROTO_DID, 5, fetch).catch(() => []),
  fetchWatching(PUBLIC_ATPROTO_DID, fetch).catch(() => []),
  fetchRecentPosts(PUBLIC_ATPROTO_DID, fetch, 3).catch(() => []),
]);

const latestWatch = watching[0];
const latestPost = feed[0];
const dateFmt = (iso: string) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", timeZone: "Europe/London" }).format(new Date(iso));
---

<Base title="Now" description="What I'm listening to, watching and saying right now." ogSubtitle="What I'm up to, live from my AT Protocol repo." ogType="NOW">
  <main class="wrap">
    <Slab word="Now" />
    <p class="lede">A live read-out, not a diary. Everything here is pulled from my own AT Protocol repo when you load the page.</p>

    <div class="cols thunk" style="--i:1"><h2>Sky</h2>
      <p class="prose" style="max-width:none">{almanac.weekday} {almanac.date}. {almanac.moon.name} moon, {almanac.sabbat.name}; {almanac.next.name} is {almanac.next.days} days off.</p>
    </div>

    <div class="cols thunk" style="--i:2"><h2>Mood</h2>
      {kibunStatus ? (
        <p class="prose" style="max-width:none"><span class="now"><span aria-hidden="true">{kibunStatus.emoji}</span>{kibunStatus.text}</span></p>
      ) : (
        <p class="empty">Nothing set.</p>
      )}
    </div>

    <div class="cols thunk" style="--i:3"><h2>Playing</h2>
      {plays.length > 0 || !musicStatus ? (
        <NowPlaying plays={plays} limit={5} />
      ) : (
        <p class="prose" style="max-width:none">
          <span class="now now--track">
            {musicStatus.artworkUrl ? <img src={musicStatus.artworkUrl} alt={`Album art for ${musicStatus.trackName}`} width="36" height="36" loading="lazy" decoding="async" /> : <span aria-hidden="true">♪</span>}
            <span>{musicStatus.trackName} — {musicStatus.artists.map((a: any) => a.artistName).join(", ")}</span>
          </span>
        </p>
      )}
    </div>

    <div class="cols thunk" style="--i:4"><h2>Watching</h2>
      {latestWatch ? (
        <p class="prose" style="max-width:none">
          {latestWatch.title}{latestWatch.rating != null && <> — {latestWatch.rating}/10</>}.
        </p>
      ) : (
        <p class="empty">Nothing logged lately.</p>
      )}
    </div>

    <div class="cols thunk" style="--i:5"><h2>Saying</h2>
      {latestPost ? (
        <p class="prose" style="max-width:none">
          <a href={`https://bsky.app/profile/${PUBLIC_ATPROTO_DID}/post/${latestPost.rkey}`} target="_blank" rel="noopener">
            {latestPost.text ? (latestPost.text.length > 220 ? `${latestPost.text.slice(0, 219)}…` : latestPost.text) : "A post without words"}
          </a>
          <br /><small class="pix">{dateFmt(latestPost.createdAt)}, on Bluesky ↗</small>
        </p>
      ) : (
        <p class="empty">Quiet on Bluesky.</p>
      )}
    </div>
  </main>
</Base>
