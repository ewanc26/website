---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import {
  fetchProfile, fetchLinks, fetchSifaProfile, fetchSifaSkills, fetchSifaEducation,
  fetchSifaLanguages, fetchSifaExternalAccounts,
} from "@ewanc26/atproto";
import { PUBLIC_ATPROTO_DID } from "$env/static/public";
import { env } from "$env/dynamic/private";
import { fetchPinnedGitHubProjects } from "$lib/services/github";
import { resolveDid } from "$lib/services/atproto/did";

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");

const did = PUBLIC_ATPROTO_DID;
const [profile, links, sifa, skills, education, languages, accounts, projects, pds] = await Promise.all([
  fetchProfile(did, fetch).catch(() => ({ displayName: "", description: "", avatar: "", handle: "", did, pronouns: "" }) as any),
  fetchLinks(did, fetch).catch(() => null),
  fetchSifaProfile(did, fetch).catch(() => null),
  fetchSifaSkills(did, fetch).catch(() => []),
  fetchSifaEducation(did, fetch).catch(() => []),
  fetchSifaLanguages(did, fetch).catch(() => []),
  fetchSifaExternalAccounts(did, fetch).catch(() => []),
  fetchPinnedGitHubProjects(env.GITHUB_USERNAME || "ewanc26", fetch, env.GITHUB_TOKEN).catch(() => []),
  // The PDS is whatever the DID document says right now, not a hardcoded host.
  resolveDid(did, fetch)
    .then((doc) => {
      const e = doc?.service?.[0]?.serviceEndpoint;
      return typeof e === "string" ? new URL(e).hostname : null;
    })
    .catch(() => null),
]);

const CATEGORY: Record<string, string> = {
  "id.sifa.defs#technical": "Technical", "id.sifa.defs#creative": "Creative",
  "id.sifa.defs#industry": "Industry", "id.sifa.defs#soft": "Soft skills",
};
const PROFICIENCY: Record<string, string> = {
  "id.sifa.defs#native": "Native", "id.sifa.defs#fluent": "Fluent",
  "id.sifa.defs#limitedWorking": "Limited working", "id.sifa.defs#elementary": "Elementary",
};
const grouped = new Map<string, any[]>();
for (const s of skills as any[]) {
  const c = CATEGORY[s.category] ?? s.category.split("#")[1] ?? "Other";
  grouped.set(c, [...(grouped.get(c) ?? []), s]);
}
const MONTHS = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const fmt = (d?: string) => {
  if (!d) return "—";
  const [y, m] = d.split("-");
  return `${MONTHS[parseInt(m)] ?? "Jan"} ${y}`;
};
const PGP = "C918 A4FC C656 BEBF 0EB7  AE01 4CB2 0882 06DB 0B7D";
---

<Base title="About" description={profile.description} ogType="ABOUT">
  <main class="sheet">
    <PageHead kicker={sifa?.headline ?? "About"} standfirst={profile.description || undefined}>
      {profile.displayName ?? profile.handle}<br /><em lang="gd">eòghann</em>
    </PageHead>
    {profile.pronouns && <p class="kicker">{profile.pronouns}</p>}

    <section class="folio" aria-labelledby="skills">
      <div class="margin"><span class="numeral">i</span><span id="skills">Skills</span></div>
      <div>
        {grouped.size === 0 && <p class="empty">Skills could not be loaded just now.</p>}
        {[...grouped.entries()].map(([cat, list]) => (
          <>
            <h3 class="h-sub">{cat}</h3>
            <p class="tags">{list.map((s) => <span class="tag">{s.name}</span>)}</p>
          </>
        ))}
      </div>
    </section>

    <section class="folio" aria-labelledby="education">
      <div class="margin"><span class="numeral">ii</span><span id="education">Education</span></div>
      {education.length === 0 ? <p class="empty">Education could not be loaded just now.</p> : (
        <ul class="toc">
          {(education as any[]).map((e) => (
            <li>
              <div class="toc-row">
                <span class="toc-title">{e.degree}</span><span class="toc-leader" aria-hidden="true"></span>
                <span class="toc-meta">{fmt(e.startedAt)} — {e.endedAt ? fmt(e.endedAt) : "Present"}</span>
                <p class="toc-note">{e.institution}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="folio" aria-labelledby="works">
      <div class="margin"><span class="numeral">iii</span><span id="works">Works</span></div>
      {projects.length === 0 ? <p class="empty">Projects could not be loaded just now.</p> : (
        <ul class="toc">
          {(projects as any[]).map((p) => (
            <li>
              <a href={p.url} rel="noopener" class="toc-row">
                <span class="toc-title">{p.name}</span><span class="toc-leader" aria-hidden="true"></span>
                <span class="toc-meta">{p.language ?? ""} ↗</span>
                {p.description && <p class="toc-note">{p.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="folio" aria-labelledby="tongues">
      <div class="margin"><span class="numeral">iv</span><span id="tongues">Tongues</span></div>
      {languages.length === 0 ? <p class="empty">Languages could not be loaded just now.</p> : (
        <ul class="toc">
          {(languages as any[]).map((l) => (
            <li><div class="toc-row"><span class="toc-title">{l.name}</span><span class="toc-leader" aria-hidden="true"></span><span class="toc-meta">{PROFICIENCY[l.proficiency] ?? l.proficiency}</span></div></li>
          ))}
        </ul>
      )}
    </section>

    <section class="folio" aria-labelledby="links">
      <div class="margin"><span class="numeral">v</span><span id="links">Links</span></div>
      <ul class="toc">
        {(accounts as any[]).map((a) => (
          <li><a href={a.url} rel="noopener" class="toc-row"><span class="toc-title">{a.label || a.url.replace("https://", "")}</span><span class="toc-leader" aria-hidden="true"></span><span class="toc-meta">↗</span></a></li>
        ))}
        {(links?.cards ?? []).map((c: any) => (
          <li><a href={c.url} rel="noopener" class="toc-row"><span class="toc-title">{c.emoji} {c.text}</span><span class="toc-leader" aria-hidden="true"></span><span class="toc-meta">↗</span></a></li>
        ))}
      </ul>
    </section>

    <section class="folio" aria-labelledby="identity">
      <div class="margin"><span class="numeral">vi</span><span id="identity">Identity</span></div>
      <dl class="dl">
        <dt>DID</dt>
        <dd><code>{profile.did}</code> <button type="button" class="btn btn--small" data-copy={profile.did}>Copy</button></dd>
        <dt>Handle</dt><dd><code>{profile.handle}</code></dd>
        <dt>PDS</dt><dd><code>{pds ?? "Unknown"}</code></dd>
        <dt>PGP</dt>
        <dd>
          <code>{PGP}</code>
          <button type="button" class="btn btn--small" data-copy={PGP.replace(/\s/g, "")}>Copy</button>
          <a href="/pgp-key.asc" class="btn btn--small">Key ↓</a>
        </dd>
        <dt>More</dt>
        <dd><a href="/about/name">About my name →</a> · <a href="/about/cv">Terminal CV →</a></dd>
      </dl>
    </section>
  </main>
</Base>
