---
import Base from "../../../../../layouts/Base.astro";
import ShareButtons from "$lib/components/ShareButtons.svelte";
import TableOfContents from "$lib/components/TableOfContents.svelte";
import CommentSection from "$lib/components/CommentSection.svelte";
import LeafletBlocks from "$lib/components/leaflet/LeafletBlocks.svelte";
import AtMentions from "$lib/components/AtMentions.svelte";
import { loadPost } from "$lib/server/post";

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");

const { year, month, day, slug } = Astro.params;
const data = await loadPost({ year: year!, month: month!, day: day!, slug: slug! });
if (!data) return Astro.rewrite("/404");

const { post, blog } = data;
const useBlocks = post.blocks && post.blocks.length > 0;
const url = Astro.url.href;
const dateLong = new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "long", day: "numeric", timeZone: "Europe/London" }).format(new Date(post.createdAt));
---

<Base
  title={post.title} description={post.metaDescription} ogSubtitle={post.description}
  type="article" ogType="ARTICLE" publishedTime={post.createdAt} tags={post.tags}
  author="https://ewancroft.uk/about" documentRkey={post.rkey}
  backlinkTargets={[post.uri, post.url].filter((v): v is string => Boolean(v))}
>
  <main class="wrap">
    <header class="post-hero">
      <p class="pix"><a href="/blog">← The archive</a></p>
      <h1 class="post-title">{post.title}</h1>
      {post.description && <p class="post-deck">{post.description}</p>}
      <div class="post-byline">
        <span class="tape">{dateLong}</span>
        {(post.tags?.length ?? 0) > 0 && <span class="chips">{post.tags!.map((t: string) => <span class="chip">{t}</span>)}</span>}
      </div>
      <div class="post-byline">
        <ShareButtons url={url} title={post.title} client:idle />
        <AtMentions url={url} aturi={post.uri} variant="default" client:idle />
      </div>
    </header>

    <div class="article">
      <aside class="rail"><TableOfContents container=".prose" client:idle /></aside>
      <div>
        <article class="prose">
          {useBlocks ? (
            <LeafletBlocks
              blocks={post.blocks} pages={post.pages} pageType={post.primaryPageType}
              sourceUrl={post.url ?? blog?.url} posts={data.readerPosts} publication={blog}
              references={data.readerReferences} client:visible
            />
          ) : (
            <Fragment set:html={post.renderedContent} />
          )}
        </article>
        <p class="post-end" aria-hidden="true">◆ ◆ ◆</p>

        <div class="post-after">
          <CommentSection comments={data.comments} subjectUri={post.uri} client:visible />
          {blog && (
            <footer>
              <h2>Published in</h2>
              <p>{blog.url ? <a href={blog.url} rel="noopener noreferrer">{blog.title}</a> : blog.title}{blog.description && <> — <em>{blog.description}</em></>}</p>
              <ul class="chips">
                <li class="chip">Standard.site</li><li class="chip">Leaflet</li>
                {blog.rss && <li><a class="chip" href={blog.rss} rel="noopener noreferrer">RSS</a></li>}
              </ul>
            </footer>
          )}
        </div>
      </div>
    </div>
  </main>
</Base>
