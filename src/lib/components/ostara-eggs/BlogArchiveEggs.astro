<div class="mac-arrival" role="status" aria-live="polite" data-cube hidden transition:persist="egg-cube">
  <div class="happy-mac" aria-hidden="true"><img src="/assets/happy-mac.svg" alt="" /></div>
  <span class="archive-status">M4 MINI · CUBE OF COMPUTING · 67 DAYS LATER</span>
</div>
<div class="entropy-status" role="status" aria-live="polite" data-entropy hidden transition:persist="egg-entropy">
  <span>AGAINST ENTROPY</span>
  <strong>STILL HERE.</strong>
</div>

<script>
  // Easter eggs #12–13, drawn from the blog archive:
  // Cube of Computing: https://blog.ewancroft.uk/3mptikkp34s2o
  // Against Entropy: https://blog.ewancroft.uk/3mljfql5ydk2i
  let keyBuffer = "";
  const timers = new Map<string, ReturnType<typeof setTimeout>>();

  function isWriting(target: EventTarget | null) {
    return target instanceof HTMLElement && (target.isContentEditable || target.matches("input, textarea, select"));
  }

  function flash(selector: string, ms: number, bodyClass?: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return;
    clearTimeout(timers.get(selector));
    el.hidden = true;
    void el.offsetWidth;
    el.hidden = false;
    if (bodyClass) document.body.classList.add(bodyClass);
    timers.set(selector, setTimeout(() => {
      el.hidden = true;
      if (bodyClass) document.body.classList.remove(bodyClass);
    }, ms));
  }

  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.key.length !== 1 || isWriting(event.target)) return;
    keyBuffer = `${keyBuffer}${event.key.toLowerCase()}`.slice(-12);
    if (keyBuffer.endsWith("cube")) {
      flash("[data-cube]", 6700);
      keyBuffer = "";
    } else if (keyBuffer.endsWith("entropy")) {
      flash("[data-entropy]", 4200, "resisting-entropy");
      keyBuffer = "";
    }
  });
</script>

