<div class="idle-toast" role="status" aria-live="polite" data-idle-toast hidden transition:persist="egg-idle">Still here? Good. So is she.</div>

<script>
  // Easter egg #8 — after 5 uninterrupted minutes, Selene checks in. Dismisses after 10 s, then re-arms.
  const IDLE_MS = 5 * 60 * 1000;
  const TOAST_MS = 10_000;
  let visible = false;
  let idleTimer: ReturnType<typeof setTimeout> | null = null;
  let hideTimer: ReturnType<typeof setTimeout> | null = null;
  const toast = () => document.querySelector<HTMLElement>("[data-idle-toast]");

  function arm() {
    if (idleTimer) clearTimeout(idleTimer);
    if (visible) return;
    idleTimer = setTimeout(show, IDLE_MS);
  }

  function show() {
    visible = true;
    const el = toast();
    if (el) {
      el.hidden = true;
      void el.offsetWidth;
      el.hidden = false;
    }
    if (hideTimer) clearTimeout(hideTimer);
    hideTimer = setTimeout(() => {
      visible = false;
      const t = toast();
      if (t) t.hidden = true;
      arm();
    }, TOAST_MS);
  }

  for (const ev of ["mousemove", "mousedown", "keydown", "touchstart", "scroll", "wheel"]) {
    document.addEventListener(ev, arm, { passive: true });
  }
  arm();
</script>

<style>
	.idle-toast {
		position: fixed;
		bottom: var(--space-lg);
		right: var(--space-lg);
		max-width: 14rem;
		background: var(--surface-raised);
		border: 1px solid var(--color-text-200);
		color: var(--color-text-700);
		font-size: var(--text-sm, 0.875rem);
		line-height: 1.5;
		padding: var(--space-3) var(--space-md);
		border-radius: var(--radius-md);
		z-index: 9999;
		pointer-events: none;
		animation:
			ie-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
			ie-out 0.4s ease-in forwards 9.6s;
	}

	@keyframes ie-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ie-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(4px);
		}
	}
</style>
