---
import Icon from "../../components/Icon.astro";
import EmptyState from "./EmptyState.astro";
import type { LeafletComment } from "$lib/services/atproto/fetch";
import { buildThread } from "$lib/utils/commentThread";

interface Props { comments: LeafletComment[]; subjectUri: string }
const { comments, subjectUri } = Astro.props as Props;
const thread = buildThread(comments);
const fmt = (iso: string) => new Date(iso).toLocaleDateString("en-gb", { year: "numeric", month: "short", day: "numeric" });
const heading = comments.length > 0 ? `${comments.length} comment${comments.length !== 1 ? "s" : ""}` : "Comments";
---

<section class="comments-section" aria-labelledby="comments-heading" data-comments data-subject={subjectUri}>
  <script is:inline type="application/json" data-comments-json set:html={JSON.stringify(comments).replace(/</g, "\\u003c")} />
  <h2 class="section-heading" id="comments-heading">
    <Icon name="message-circle" size={16} />
    <span data-comments-heading>{heading}</span>
  </h2>

  <div class="comment-composer" data-composer>
    <p class="composer-note" role="status">Checking AT Protocol sign-in…</p>
  </div>

  <ul class="comment-list" data-comment-list hidden={thread.length === 0}>
    {thread.map(({ comment, depth }) => (
      <li class="comment" style={`--comment-depth:${depth}`}>
        <div class="comment-head">
          <strong>{comment.authorDisplayName ?? comment.authorHandle}</strong>
          <a href={`https://bsky.app/profile/${encodeURIComponent(comment.authorDid)}`} target="_blank" rel="noopener noreferrer" class="comment-handle">@{comment.authorHandle}</a>
          <time class="comment-date" datetime={comment.createdAt}>{fmt(comment.createdAt)}</time>
        </div>
        <p class="comment-body">{comment.plaintext}</p>
      </li>
    ))}
  </ul>
  <div data-comments-empty hidden={thread.length > 0}>
    <EmptyState title="No comments yet" description="Be the first to share your thoughts on this post." icon={false} />
  </div>
</section>

<script>
  import { buildThread } from "$lib/utils/commentThread";
  import type { LeafletComment } from "$lib/services/atproto/fetch";
  import { initReaderSession, publishLeafletComment, signInReader, signOutReader, type ReaderSession } from "$lib/services/atproto/commentClient";
  import { pulseAmbiance } from "$lib/stores/ambiance";

  const ICONS = {
    out: '<path d="m16 17 5-5-5-5"/><path d="M21 12H9"/><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>',
    in: '<path d="m10 17 5-5-5-5"/><path d="M15 12H3"/><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>',
    send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
    reply: '<polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/>',
  };
  const icon = (name: keyof typeof ICONS, size = 14) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const fmt = (iso: string) => new Date(iso).toLocaleDateString("en-gb", { year: "numeric", month: "short", day: "numeric" });
  const msg = (e: unknown, fallback: string) => (e instanceof Error ? e.message : fallback);

  function setup(root: HTMLElement) {
    const composer = root.querySelector<HTMLElement>("[data-composer]")!;
    const list = root.querySelector<HTMLUListElement>("[data-comment-list]")!;
    const empty = root.querySelector<HTMLElement>("[data-comments-empty]")!;
    const headingEl = root.querySelector<HTMLElement>("[data-comments-heading]")!;
    const subjectUri = root.dataset.subject!;
    const base: LeafletComment[] = JSON.parse(root.querySelector("[data-comments-json]")!.textContent || "[]");
    const local: LeafletComment[] = [];

    let session: ReaderSession | null = null;
    let identifier = "";
    let draft = "";
    let replyingTo: LeafletComment | null = null;
    let busy = false;
    let authReady = false;
    let error = "";
    let notice = "";

    function renderList() {
      const all = [...base, ...local];
      const thread = buildThread(all);
      headingEl.textContent = all.length > 0 ? `${all.length} comment${all.length !== 1 ? "s" : ""}` : "Comments";
      list.hidden = thread.length === 0;
      empty.hidden = thread.length > 0;
      list.innerHTML = thread
        .map(({ comment: c, depth }) => `
          <li class="comment" style="--comment-depth:${depth}">
            <div class="comment-head">
              <strong>${esc(c.authorDisplayName ?? c.authorHandle)}</strong>
              <a href="https://bsky.app/profile/${encodeURIComponent(c.authorDid)}" target="_blank" rel="noopener noreferrer" class="comment-handle">@${esc(c.authorHandle)}</a>
              <time class="comment-date" datetime="${esc(c.createdAt)}">${fmt(c.createdAt)}</time>
            </div>
            <p class="comment-body">${esc(c.plaintext)}</p>
            ${session ? `<button type="button" class="comment-reply-button" data-reply="${esc(c.uri)}">${icon("reply", 13)} Reply</button>` : ""}
          </li>`)
        .join("");
    }

    function renderComposer() {
      const status =
        (error ? `<p class="comment-status comment-status--error" role="alert">${esc(error)}</p>` : "") +
        (notice ? `<p class="comment-status" role="status">${esc(notice)}</p>` : "");
      const dis = busy ? "disabled" : "";
      if (session) {
        composer.innerHTML = `
          <div class="comment-session-row">
            <span>Commenting as <strong>@${esc(session.handle)}</strong></span>
            <button type="button" class="comment-link-button" data-signout ${dis}>${icon("out")} Sign out</button>
          </div>
          ${replyingTo ? `<div class="replying-to"><span>Replying to <strong>@${esc(replyingTo.authorHandle)}</strong></span><button type="button" class="comment-link-button" data-cancel-reply>Cancel</button></div>` : ""}
          <label class="sr-only" for="leaflet-comment-draft">Your comment</label>
          <textarea id="leaflet-comment-draft" rows="4" placeholder="${replyingTo ? `Reply to @${esc(replyingTo.authorHandle)}…` : "Share your thoughts…"}" ${dis}>${esc(draft)}</textarea>
          <div class="composer-actions">
            <span class="composer-note">Published as a <code>pub.leaflet.comment</code> record in your own repo.</span>
            <button type="button" class="comment-primary-button" data-submit ${busy || !draft.trim() ? "disabled" : ""}>${icon("send")} ${busy ? "Publishing…" : "Publish comment"}</button>
          </div>${status}`;
      } else if (!authReady) {
        composer.innerHTML = `<p class="composer-note" role="status">Checking AT Protocol sign-in…</p>${status}`;
      } else {
        composer.innerHTML = `
          <form class="comment-signin" data-signin>
            <div class="comment-signin-fields">
              <label><span>AT Protocol handle</span>
                <input autocomplete="username" placeholder="you.example.com" value="${esc(identifier)}" ${dis} required />
              </label>
            </div>
            <div class="composer-actions">
              <span class="composer-note">Sign in with AT Protocol OAuth. This reader only requests permission to create <code>pub.leaflet.comment</code> records in your repo; your password is never shared with this site.</span>
              <button type="submit" class="comment-primary-button" ${busy || !identifier.trim() ? "disabled" : ""}>${icon("in")} ${busy ? "Opening sign-in…" : "Sign in to comment"}</button>
            </div>
          </form>${status}`;
      }
    }

    const render = () => { renderComposer(); renderList(); };

    // Typing must not re-render (would drop focus); only toggle the submit button.
    composer.addEventListener("input", (e) => {
      const t = e.target as HTMLInputElement | HTMLTextAreaElement;
      if (t.tagName === "TEXTAREA") {
        draft = t.value;
        composer.querySelector<HTMLButtonElement>("[data-submit]")!.disabled = busy || !draft.trim();
      } else if (t.tagName === "INPUT") {
        identifier = t.value;
        composer.querySelector<HTMLButtonElement>("button[type=submit]")!.disabled = busy || !identifier.trim();
      }
    });

    composer.addEventListener("submit", async (e) => {
      e.preventDefault();
      error = notice = "";
      busy = true;
      render();
      try {
        const returnTo = `${location.pathname}${location.search}${location.hash}`;
        await signInReader(identifier, returnTo);
      } catch (cause) {
        error = msg(cause, "Could not start AT Protocol sign-in.");
        busy = false;
        render();
      }
    });

    composer.addEventListener("click", async (e) => {
      const target = e.target as Element;
      if (target.closest("[data-cancel-reply]")) {
        replyingTo = null;
        render();
      } else if (target.closest("[data-signout]") && session) {
        error = notice = "";
        busy = true;
        render();
        try {
          await signOutReader(session);
          session = null;
          replyingTo = null;
          notice = "Signed out from commenting.";
        } catch (cause) {
          error = msg(cause, "Could not sign out.");
        } finally {
          busy = false;
          render();
        }
      } else if (target.closest("[data-submit]") && session) {
        error = notice = "";
        busy = true;
        const text = draft.trim();
        const parent = replyingTo?.uri;
        render();
        try {
          const created = await publishLeafletComment(session, subjectUri, text, parent);
          local.push({
            uri: created.uri,
            plaintext: text,
            createdAt: new Date().toISOString(),
            authorDid: session.did,
            authorHandle: session.handle,
            reply: parent ? { parent } : undefined,
          });
          draft = "";
          replyingTo = null;
          notice = "Comment published to your AT Protocol repository. It may take a moment to appear in other Leaflet readers.";
          pulseAmbiance();
        } catch (cause) {
          error = msg(cause, "Could not publish the comment.");
        } finally {
          busy = false;
          render();
        }
      }
    });

    list.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>("[data-reply]");
      if (!btn) return;
      const target = [...base, ...local].find((c) => c.uri === btn.dataset.reply);
      if (!target) return;
      replyingTo = target;
      error = notice = "";
      renderComposer();
      composer.querySelector<HTMLTextAreaElement>("#leaflet-comment-draft")?.focus();
    });

    renderComposer();
    (async () => {
      try {
        session = await initReaderSession();
        if (session) identifier = session.handle;
      } catch (cause) {
        error = msg(cause, "Could not restore AT Protocol sign-in.");
      } finally {
        authReady = true;
        render();
      }
    })();
  }

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-comments]");
    if (root) setup(root);
  });
</script>

<style is:global>
  [data-comments] [hidden] { display: none; }
  .comment-composer {
      margin: 0 0 1.5rem;
      padding: 1rem;
      border: 1px solid var(--border-subtle, currentColor);
      border-radius: 0;
  }

  .comment-session-row,
  .replying-to,
  .composer-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
  }

  .replying-to {
      margin: 0.65rem 0;
      font-size: 0.875rem;
  }

  textarea,
  input {
      box-sizing: border-box;
      width: 100%;
      border: 1px solid var(--border-subtle, currentColor);
      border-radius: 0;
      background: var(--surface, transparent);
      color: inherit;
      font: inherit;
  }

  textarea {
      margin: 0.75rem 0;
      padding: 0.75rem;
      resize: vertical;
  }

  input { padding: 0.6rem 0.7rem; }

  .comment-signin-fields {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      margin-bottom: 0.75rem;
  }

  .comment-signin-fields label {
      display: grid;
      gap: 0.35rem;
      font-family: var(--font-mono);
      font-size: var(--text-micro);
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
  }

  .comment-primary-button,
  .comment-link-button,
  .comment-reply-button {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font: inherit;
      cursor: pointer;
  }

  .comment-primary-button {
      flex: none;
      padding: 0.55rem 0.8rem;
      border: 1px solid currentColor;
      border-radius: 0;
      background: transparent;
      color: inherit;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
  }

  .comment-primary-button:hover:not(:disabled) {
      background: var(--ink);
      color: var(--paper);
  }

  .comment-primary-button:disabled,
  .comment-link-button:disabled { opacity: 0.55; cursor: not-allowed; }

  .comment-link-button,
  .comment-reply-button {
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.16em;
  }

  .comment-reply-button {
      margin-top: 0.35rem;
      font-size: 0.82rem;
      opacity: 0.75;
  }

  .composer-note,
  .comment-status {
      margin: 0;
      font-size: 0.8rem;
      opacity: 0.72;
  }

  .composer-note { max-width: 42rem; }
  .comment-status { margin-top: 0.75rem; }
  .comment-status--error { opacity: 1; }

  .comment-list .comment {
      margin-inline-start: min(calc(var(--comment-depth, 0) * 1.25rem), 7.5rem);
  }

  .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
  }

  @media (max-width: 640px) {
      .composer-actions { align-items: flex-start; flex-direction: column; }
      .comment-list .comment { margin-inline-start: min(calc(var(--comment-depth, 0) * 0.75rem), 3rem); }
  }
</style>
