---
interface Props {
  size?: number | string;
  class?: string;
}
const { size = "0.85em", class: className = "" } = Astro.props as Props;
---
<svg
	viewBox="0 0 24 24"
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	class={`ui-icon arrow-ur ${className}`.trim()}
	aria-hidden="true"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<path d="M7 7h10v10" />
	<path d="M7 17 17 7" />
</svg>
<style is:global>
	.arrow-ur { display: inline-block; vertical-align: -0.05em; margin-inline-start: 0.15em; flex: none; }
</style>
