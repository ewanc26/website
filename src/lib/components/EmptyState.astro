---
import Icon from "../../components/Icon.astro";
interface Props { title: string; description: string; icon?: boolean }
const { title, description, icon = true } = Astro.props as Props;
---
<div class="empty-state">
  {icon && <div class="empty-state-icon"><Icon name="circle-alert" size={32} /></div>}
  <p class="empty-state-title">{title}</p>
  <p class="empty-state-text">{description}</p>
</div>

<style>
  .empty-state {
    padding: var(--space-lg);
    border: 1px solid var(--surface-color);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .empty-state-icon {
    color: var(--color-ink-500);
  }

  .empty-state-title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink-700);
  }

  .empty-state-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-600);
    line-height: 1.6;
    max-width: 55ch;
  }
</style>
