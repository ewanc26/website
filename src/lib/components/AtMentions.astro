---
import LoadingSkeleton from "./LoadingSkeleton.astro";
interface Props { url: string; aturi?: string; variant?: "default" | "minimal" | "full" | "mentions"; class?: string }
const { url, aturi, variant = "default", class: className = "" } = Astro.props as Props;
---

<div
  class={`atmentions-wrapper ${className}`}
  style="--atmo-fg:var(--color-ink-800);--atmo-accent:var(--color-primary-500);--atmo-muted:var(--color-ink-600)"
  data-atmentions
  data-url={url}
  data-aturi={aturi || undefined}
  data-variant={variant}
>
  <LoadingSkeleton label="Loading reactions" />
</div>

<script>
  async function mount() {
    const hosts = document.querySelectorAll<HTMLElement>("[data-atmentions]:not([data-mounted])");
    if (!hosts.length) return;
    hosts.forEach((h) => (h.dataset.mounted = "1"));
    try {
      // Import registers the <atmentions-reactions> custom element.
      await import("atmentions");
    } catch {
      hosts.forEach((h) => h.replaceChildren());
      return;
    }
    hosts.forEach((host) => {
      const el = document.createElement("atmentions-reactions");
      el.className = "content-reveal";
      el.setAttribute("data-url", host.dataset.url ?? "");
      if (host.dataset.aturi) el.setAttribute("data-aturi", host.dataset.aturi);
      el.setAttribute("variant", host.dataset.variant ?? "default");
      host.replaceChildren(el);
    });
  }
  document.addEventListener("astro:page-load", mount);
</script>
