---
import type { FacetSchema } from "$lib/providers/facets";
import { renderFacets, type SerialisedFacet } from "$lib/utils/leafletFacets";

interface Props {
  plaintext: string;
  facets?: SerialisedFacet[];
  schema: FacetSchema;
  footnoteNumbers?: Record<string, number>;
}
const { plaintext, facets, schema, footnoteNumbers = {} } = Astro.props as Props;
---
<Fragment set:html={renderFacets(plaintext, facets, schema, footnoteNumbers)} />

<style is:global>
  .leaflet-footnote-ref {
    margin-inline: 0.08em;
    font-size: 0.72em;
    line-height: 0;
    vertical-align: super;
  }

  .leaflet-footnote-ref a {
    text-decoration: none;
  }
</style>
