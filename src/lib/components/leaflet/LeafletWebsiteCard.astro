---
import Icon from "../../../components/Icon.astro";
import { safeHostname, safeLinkUrl, safeResourceUrl } from "$lib/utils/url";
const { src, title, description, previewImageSrc } = Astro.props as {
  src: string; title?: string; description?: string; previewImageSrc?: string;
};
// Remote block data is untrusted: reject unsafe schemes; safeHostname never throws.
const href = safeLinkUrl(src);
const hostname = safeHostname(src);
const previewSrc = safeResourceUrl(previewImageSrc);
---
{href && (
  <a href={href} target="_blank" rel="noopener noreferrer" class="leaflet-website-card">
    {previewSrc && <div class="website-card-image"><img src={previewSrc} alt="" loading="lazy" decoding="async" /></div>}
    <div class="website-card-body">
      {title && <strong class="website-card-title">{title}</strong>}
      {description && <p class="website-card-desc">{description}</p>}
      {hostname && <span class="website-card-url"><Icon name="external-link" size={12} /> {hostname}</span>}
    </div>
  </a>
)}
