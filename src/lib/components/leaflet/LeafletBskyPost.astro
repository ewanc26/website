---
import { blueskyPostUrl } from "$lib/utils/bluesky";
interface RecordView { value?: Record<string, unknown> }
const { postRef, clientHost, record } = Astro.props as {
  postRef: { uri: string; cid: string }; clientHost?: string; record?: RecordView;
};
const embedUrl = blueskyPostUrl(postRef.uri, clientHost);
const text = typeof record?.value?.text === "string" ? record.value.text : undefined;
const createdAt = typeof record?.value?.createdAt === "string" ? record.value.createdAt : undefined;
---
<figure class="leaflet-bsky-post">
  {text && <blockquote>{text}</blockquote>}
  <figcaption>
    {createdAt && (
      <>
        <time datetime={createdAt}>{new Date(createdAt).toLocaleDateString("en-gb", { year: "numeric", month: "short", day: "2-digit" })}</time>
        <span aria-hidden="true"> · </span>
      </>
    )}
    <a href={embedUrl} target="_blank" rel="noopener noreferrer">View on Bluesky →</a>
  </figcaption>
</figure>

<style>
  .leaflet-bsky-post {
    margin-block: 1rem;
    border: 1px solid currentColor;
    border-radius: 0;
    padding: 1rem;
  }

  blockquote {
    margin: 0 0 0.75rem;
    white-space: pre-wrap;
  }

  figcaption {
    font-size: 0.85em;
    opacity: 0.8;
  }
</style>
