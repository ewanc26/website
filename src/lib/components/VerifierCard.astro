---
import { getPlaceholderAvatar } from "$lib/utils/avatar";
interface Props { did: string; name: string; avatarUrl?: string; date: string; handle?: string }
const { did, name, avatarUrl, handle } = Astro.props as Props;
---
<div class="verifier-card">
  <div class="avatar">
    <img src={avatarUrl || getPlaceholderAvatar(did)} alt="" width="32" height="32" loading="lazy" decoding="async" />
  </div>
  <div class="verifier-info">
    <span class="name">{name}</span>
    {handle && <span class="handle">@{handle}</span>}
  </div>
</div>

<style>
  .verifier-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--surface-color);
    border-radius: var(--radius-md);
  }
  .avatar, .avatar img {
    width: 32px;
    height: 32px;
    border-radius: 0;
  }
  .verifier-info {
    display: flex;
    flex-direction: column;
  }
  .name {
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .handle {
    font-size: var(--text-xs);
    color: var(--color-text-600);
  }
</style>
