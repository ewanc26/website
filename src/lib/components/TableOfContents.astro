---
interface Props { container: string; selector?: string }
const { container, selector = "h2, h3, h4" } = Astro.props as Props;
---

<nav aria-label="Table of contents" class="page-outline outline-placeholder" data-toc data-container={container} data-selector={selector}>
  <h2>Contents</h2>
  <ol>
    {Array.from({ length: 6 }, () => <li><span class="outline-skeleton"></span></li>)}
  </ol>
</nav>

<script>
  /** Slug-ify heading text, disambiguating duplicates. Matches LeafletBlocks headingId(). */
  function makeSlug(text: string, seen: Map<string, number>): string {
    const base = text.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
    const count = seen.get(base) ?? 0;
    seen.set(base, count + 1);
    return count === 0 ? base : `${base}-${count}`;
  }

  function build() {
    document.querySelectorAll<HTMLElement>("[data-toc]").forEach((nav) => {
      const el = document.querySelector(nav.dataset.container ?? "");
      const seen = new Map<string, number>();
      const entries = Array.from(el?.querySelectorAll<HTMLElement>(nav.dataset.selector ?? "") ?? []).map((h) => {
        if (!h.id) h.id = makeSlug(h.textContent ?? "", seen);
        else {
          const base = h.id.replace(/-\d+$/, "");
          seen.set(base, (seen.get(base) ?? 0) + 1);
        }
        return { id: h.id, text: h.textContent ?? "", level: parseInt(h.tagName[1]) };
      });

      if (entries.length <= 1) {
        const sentinel = document.createElement("div");
        sentinel.className = "outline-sentinel";
        nav.replaceWith(sentinel);
        return;
      }
      nav.classList.remove("outline-placeholder");
      const ol = nav.querySelector("ol")!;
      ol.replaceChildren(
        ...entries.map((entry) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#${entry.id}`;
          a.className = "outline-link" + (entry.level === 3 ? " h3" : entry.level === 4 ? " h4" : "");
          a.textContent = entry.text;
          li.append(a);
          return li;
        }),
      );
    });
  }

  document.addEventListener("astro:page-load", build);
</script>
