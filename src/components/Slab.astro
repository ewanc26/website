---
/**
 * The page word: colossal, cropped by the sheet, printed twice — once in
 * each ink, the second plate a hair out of register.
 */
interface Props {
  word: string;
  long?: boolean;
  sigils?: boolean;
}
import SigilBand from "./SigilBand.astro";

const { word, long = false, sigils = true } = Astro.props;
---

{sigils && <SigilBand seed={word} />}
<h1 class:list={["slab", { "slab--long": long }]} data-t={word} style={`--n:${word.length + (word.length <= 3 ? 0.6 : 0)}`}>{word}</h1>
