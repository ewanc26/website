---
import Pentacle from "$lib/components/icons/Pentacle.astro";
import Triskele from "$lib/components/icons/Triskele.astro";
---

<div class="sigil-rule" aria-hidden="true">
  <i></i>
  <Pentacle size={30} class="sr-a" />
  <i></i>
  <Triskele size={30} class="sr-b" />
  <i></i>
</div>

<style>
  .sigil-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--wrap, 72rem);
    margin: var(--space-2xl) auto var(--space-lg);
    padding-inline: var(--gutter);
  }
  .sigil-rule i {
    flex: 1;
    height: 0;
    border-top: var(--edge, 2px) solid var(--ink);
  }
  .sigil-rule :global(.sr-a) {
    color: var(--riso-a-text);
  }
  .sigil-rule :global(.sr-b) {
    color: var(--riso-b-text);
  }
</style>
