---
/**
 * The sabbat seal: the current sabbat's name runs round a ring that turns
 * once every ninety seconds, with the moon as it stands tonight at the
 * centre. Purely decorative (aria-hidden); the same facts are in the
 * running head as text.
 */
import { getMoonPhaseGeometry } from "$lib/utils/moonPhase";
import type { Almanac } from "$lib/utils/almanac";

interface Props {
  almanac: Almanac;
  class?: string;
}
const { almanac, class: className } = Astro.props;
const geometry = getMoonPhaseGeometry(almanac.moon.phase);
const ring = `${almanac.sabbat.name} · Wheel of the Year · `.toUpperCase();
---

<svg class:list={["stamp", className]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <path id="stamp-ring-path" d="M50 50 m-40 0 a40 40 0 1 1 80 0 a40 40 0 1 1 -80 0"></path>
  </defs>
  <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="0.8"></circle>
  <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="0.8"></circle>
  <g class="stamp-ring">
    <text>
      <textPath href="#stamp-ring-path" textLength="250" lengthAdjust="spacing">{ring}</textPath>
    </text>
  </g>
  <svg x="32" y="32" width="36" height="36" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.14"></circle>
    {geometry.isFull && <circle cx="12" cy="12" r="9" fill="currentColor" />}
    {!geometry.isFull && geometry.path && (
      <path d={geometry.path} fill="currentColor" fill-rule={geometry.isGibbous ? "evenodd" : "nonzero"} />
    )}
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="0.7"></circle>
  </svg>
</svg>
