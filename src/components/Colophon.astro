---
/**
 * The press: a print shop's back page. What it was printed in, the
 * calibration colour bar, tonight's moon among its eight phases.
 */
import PixelMoon from "./PixelMoon.astro";
import WolfToggle from "$lib/components/layout/WolfToggle.astro";
import AmbianceToggle from "$lib/components/layout/AmbianceToggle.astro";
import TriskeleEgg from "$lib/components/ostara-eggs/TriskeleEgg.astro";
import Pentacle from "$lib/components/icons/Pentacle.astro";
import Saltire from "$lib/components/icons/Saltire.astro";
import type { Almanac } from "$lib/utils/almanac";
import type { NormalizedSiteInfo } from "$lib/services/atproto/siteInfo";
import { PUBLIC_ATPROTO_DID } from "$env/static/public";

interface Props {
  almanac: Almanac;
  siteInfo: NormalizedSiteInfo | null;
}
const { almanac, siteInfo } = Astro.props;

const year = new Date().getFullYear();
const born = siteInfo?.additionalInfo?.websiteBirthYear;
const years = born && born < year ? `${born}–${year}` : `${year}`;
const repo = siteInfo?.openSourceInfo?.repositories.find((r) => r.type === "primary") ?? siteInfo?.openSourceInfo?.repositories[0];
const license = siteInfo?.openSourceInfo?.license;
const email = siteInfo?.additionalInfo?.contact?.email ?? "contact@ewancroft.uk";

const phases = Array.from({ length: 8 }, (_, i) => i / 8);
const current = Math.round(almanac.moon.phase * 8) % 8;
---

<footer class="press">
  <div class="wrap">
    <div class="press-grid">
      <section>
        <h2>Colophon</h2>
        <p>
          Printed in two inks, mixed for {almanac.sabbat.name}, on newsprint by day and black stock by night.
          Set in Archivo, Atkinson Hyperlegible Next and Pixelify Sans.
        </p>
        <details>
          <summary>About {almanac.sabbat.name}</summary>
          <p>{almanac.sabbat.description}</p>
        </details>
      </section>

      <section>
        <h2>Write to me</h2>
        <ul>
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li><a href={`https://bsky.app/profile/${PUBLIC_ATPROTO_DID}`} rel="noopener">Bluesky</a> · <a href="https://eurosky.tech" rel="noopener">Eurosky</a></li>
          <li><a href="https://ko-fi.com/ewancroft" rel="noopener">Ko-fi</a> · <a href="https://github.com/sponsors/ewanc26" rel="noopener">GitHub Sponsors</a></li>
        </ul>
      </section>

      <section>
        <h2>Small print</h2>
        <ul>
          <li><a href="/subscriptions">What I read</a></li>
          {repo && <li><a href={repo.url} rel="noopener">Source code</a></li>}
          {license && <li><a href={license.url} rel="license noopener">{license.name ?? "Licence"}</a></li>}
          <li><a href="/site/design">How this was made</a></li>
          <li><a href="/site/meta">Site meta &amp; privacy</a></li>
        </ul>
      </section>
    </div>

    <div class="colorbar" role="img" aria-label="Colour calibration bar: paper, second ink, first ink, both inks overprinted, black">
      <i class="sw-paper"></i><i class="sw-b"></i><i class="sw-a"></i><i class="sw-ov"></i><i class="sw-ink"></i>
    </div>

    <div class="press-base">
      <span>© {years} Ewan Croft · no cookies, no tracking</span>
      <ul class="moons" aria-label={`Moon phases; tonight is a ${almanac.moon.name.toLowerCase()}`}>
        {phases.map((p, i) => (
          <li aria-current={i === current ? "true" : undefined} title={i === current ? `Tonight: ${almanac.moon.name.toLowerCase()}` : undefined}>
            <PixelMoon phase={p} size={22} />
          </li>
        ))}
      </ul>
      <span class="press-tools">
        <span class="sigils">
          <Pentacle size={13} aria-label="Pagan" aria-hidden={false} />
          <TriskeleEgg size={12} />
          <Saltire size={13} aria-label="Scottish" aria-hidden={false} />
        </span>
        <WolfToggle />
        <AmbianceToggle />
      </span>
    </div>
  </div>
</footer>
