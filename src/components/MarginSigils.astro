---
import Pentacle from "$lib/components/icons/Pentacle.astro";
import Triskele from "$lib/components/icons/Triskele.astro";

interface Props {
  seed?: string;
}

type Mark = {
  kind: "p" | "t";
  side: "left" | "right";
  x: number;
  y: number;
  size: number;
  rotate: number;
};

const { seed = "" } = Astro.props;

let hash = 2166136261;
for (const char of seed) {
  hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);
}

const next = () => {
  hash = Math.imul(hash + 0x6d2b79f5, 1);
  let value = Math.imul(hash ^ (hash >>> 15), 1 | hash);
  value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
  return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
};

const marks: Mark[] = [];

for (const side of ["left", "right"] as const) {
  const positions: Array<[number, number]> = [];
  const count = 10 + Math.floor(next() * 3);

  for (let i = 0; i < count; i++) {
    let x = 0.14 + next() * 0.72;
    let y = 0.06 + next() * 0.88;
    let attempts = 0;

    while (
      positions.some(([existingX, existingY]) => {
        const dx = existingX - x;
        const dy = existingY - y;
        return Math.sqrt(dx * dx + dy * dy) < 0.13;
      }) &&
      attempts < 80
    ) {
      x = 0.14 + next() * 0.72;
      y = 0.06 + next() * 0.88;
      attempts++;
    }

    positions.push([x, y]);
    marks.push({
      kind: next() > 0.5 ? "p" : "t",
      side,
      x,
      y,
      size: 1.45 + next() * 1.05,
      rotate: -30 + next() * 60,
    });
  }
}
---

<aside class="margin-sigils" aria-hidden="true">
  {
    marks.map(({ kind, side, x, y, size, rotate }) => {
      const style =
        "--x:" +
        x +
        ";--y:" +
        y * 100 +
        "%;--s:" +
        size +
        "rem;--r:" +
        rotate +
        "deg";

      return kind === "p" ? (
        <span class:list={["margin-sigil", "margin-sigil--" + side, "margin-sigil--pentacle"]} style={style}>
          <Pentacle size={48} />
        </span>
      ) : (
        <span class:list={["margin-sigil", "margin-sigil--" + side, "margin-sigil--triskele"]} style={style}>
          <Triskele size={48} />
        </span>
      );
    })
  }
</aside>

<style>
  .margin-sigils {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .margin-sigil {
    position: absolute;
    top: var(--y);
    width: var(--s);
    height: var(--s);
    opacity: 1;
    rotate: var(--r);
    translate: -50% -50%;
  }

  .margin-sigil--pentacle {
    color: var(--riso-a);
  }

  .margin-sigil--triskele {
    color: var(--riso-b);
  }

  .margin-sigil--left {
    left: calc((100vw - var(--wrap)) / 2 * var(--x));
  }

  .margin-sigil--right {
    right: calc((100vw - var(--wrap)) / 2 * var(--x));
  }

  .margin-sigil :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 100rem) {
    .margin-sigils {
      display: block;
    }
  }
</style>
