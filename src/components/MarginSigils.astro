---
import Pentacle from "$lib/components/icons/Pentacle.astro";
import Triskele from "$lib/components/icons/Triskele.astro";

interface Props {
  seed?: string;
}

type Mark = {
  kind: "p" | "t";
  side: "left" | "right";
  y: number;
  size: number;
  rotate: number;
  inset: number;
};

const { seed = "" } = Astro.props;

let hash = 2166136261;
for (const char of seed) {
  hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);
}

const next = () => {
  hash = Math.imul(hash + 0x6d2b79f5, 1);
  let value = Math.imul(hash ^ (hash >>> 15), 1 | hash);
  value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
  return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
};

const marks: Mark[] = [];

for (const side of ["left", "right"] as const) {
  const positions: number[] = [];
  const count = 5 + Math.floor(next() * 3);

  for (let i = 0; i < count; i++) {
    let y = 8 + next() * 84;
    let attempts = 0;

    while (
      positions.some((existing) => Math.abs(existing - y) < 9) &&
      attempts < 24
    ) {
      y = 8 + next() * 84;
      attempts++;
    }

    positions.push(y);
    marks.push({
      kind: next() > 0.5 ? "p" : "t",
      side,
      y,
      size: 1.5 + next() * 1,
      rotate: -30 + next() * 60,
      inset: 0.25 + next() * 1.25,
    });
  }
}
---

<aside class="margin-sigils" aria-hidden="true">
  {
    marks.map(({ kind, side, y, size, rotate, inset }) => {
      const style =
        "--y:" +
        y +
        "%;--s:" +
        size +
        "rem;--r:" +
        rotate +
        "deg;--i:" +
        inset +
        "rem";

      return kind === "p" ? (
        <span class:list={["margin-sigil", "margin-sigil--" + side, "margin-sigil--pentacle"]} style={style}>
          <Pentacle size={48} />
        </span>
      ) : (
        <span class:list={["margin-sigil", "margin-sigil--" + side, "margin-sigil--triskele"]} style={style}>
          <Triskele size={48} />
        </span>
      );
    })
  }
</aside>

<style>
  .margin-sigils {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .margin-sigil {
    position: absolute;
    top: var(--y);
    width: var(--s);
    height: var(--s);
    opacity: 1;
    rotate: var(--r);
    translate: 0 -50%;
  }

  .margin-sigil--pentacle {
    color: var(--riso-a);
  }

  .margin-sigil--triskele {
    color: var(--riso-b);
  }

  .margin-sigil--left {
    left: max(
      1rem,
      calc((100vw - var(--wrap)) / 2 - var(--s) - var(--i))
    );
  }

  .margin-sigil--right {
    right: max(
      1rem,
      calc((100vw - var(--wrap)) / 2 - var(--s) - var(--i))
    );
  }

  .margin-sigil :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 100rem) {
    .margin-sigils {
      display: block;
    }
  }
</style>
